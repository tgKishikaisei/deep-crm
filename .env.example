# Скопируйте в .env и заполните. Файл .env не коммитится (.gitignore).
# Сгенерировать ключ: python -c "from django.core.management.utils import get_random_secret_key as g; print(g()+g())"
SECRET_KEY=
ALLOWED_HOSTS=crm.example.com
CSRF_TRUSTED_ORIGINS=https://crm.example.com
# Сколько обратных прокси перед приложением (nginx = 1); нужно для верного IP в django-axes.
TRUSTED_PROXY_COUNT=1
ADMIN_URL=secret-control-panel-999/

DB_NAME=crm_db
DB_USER=crm
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_PASSWORD=
# Локально без Docker: redis://:ПАРОЛЬ@127.0.0.1:6379 (в docker-compose задаётся автоматически)
REDIS_URL=redis://127.0.0.1:6379

# Почта (prod): SMTP с TLS
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
